<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job para sincronizar órdenes de TiendaNube mediante polling -->
        <record id="ir_cron_sync_orders_tiendanube" model="ir.cron">
            <field name="name">Sincronizar Órdenes de TiendaNube (Polling)</field>
            <field name="model_id" ref="model_tn_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_orders_by_polling()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
