<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_import_publications_tiendanube" model="ir.cron">
            <field name="name">Importar Publicaciones TiendaNube (lotes)</field>
            <field name="model_id" ref="model_tn_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_import_publications_batch()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_scan_new_tn_publications" model="ir.cron">
            <field name="name">TiendaNube: detectar publicaciones nuevas (scan diario)</field>
            <field name="model_id" ref="model_tn_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_scan_new_tn_publications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
