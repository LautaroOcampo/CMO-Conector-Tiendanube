<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista de configuraciones -->
    <record id="view_tn_config_list" model="ir.ui.view">
        <field name="name">tn.config.list</field>
        <field name="model">tn.config</field>
        <field name="arch" type="xml">
            <list string="Configuraciones TiendaNube">
                <field name="name"/>
                <field name="store_id"/>
                <field name="tn_store_country_id" optional="show"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario de configuración -->
    <record id="view_tn_config_form" model="ir.ui.view">
        <field name="name">tn.config.form</field>
        <field name="model">tn.config</field>
        <field name="arch" type="xml">
            <form string="Configuración TiendaNube">
                <header>
                    <button name="action_authorize" string="Autorizar Aplicación" type="object" class="oe_highlight" icon="fa-key" groups="tiendanube_connector.group_tn_manager"/>
                    <button name="action_test_connection" string="Probar Conexión" type="object" class="btn-primary" icon="fa-plug" groups="tiendanube_connector.group_tn_manager"/>
                    <button name="action_refresh_token" string="Refrescar Token" type="object" class="btn-secondary" icon="fa-refresh" groups="tiendanube_connector.group_tn_manager"/>
                    <button name="action_import_publications" string="Importar Publicaciones" type="object" class="oe_highlight" icon="fa-download" groups="tiendanube_connector.group_tn_manager" invisible="import_publications_active"/>
                    <button name="action_stop_import_publications" string="Detener importación" type="object" class="btn-warning" icon="fa-stop" groups="tiendanube_connector.group_tn_manager" invisible="not import_publications_active"/>
                    <button name="action_verify_webhook" string="Verificar Webhook" type="object" class="btn-primary" icon="fa-bell" groups="tiendanube_connector.group_tn_manager"/>
                    <button name="action_recreate_webhook" string="Sincronizar Webhook" type="object" class="btn-secondary" icon="fa-refresh" groups="tiendanube_connector.group_tn_manager"/>
                    <button name="action_auto_link_all_products_by_sku" string="Auto-relacionar Productos por SKU" type="object" class="btn-secondary" icon="fa-link" groups="tiendanube_connector.group_tn_manager"/>
                    <button name="action_view_stock_sync_publications" string="Ver Publicaciones que Sincronizarían Stock" type="object" class="btn-secondary" icon="fa-eye" groups="tiendanube_connector.group_tn_manager"/>
                    <button name="action_sync_all_stocks" string="Sincronizar Todos los Stocks" type="object" class="oe_highlight" icon="fa-cubes" groups="tiendanube_connector.group_tn_manager"/>
                    <button name="action_sync_orders_now" string="Importar ventas / reintento webhook" type="object" class="btn-primary" icon="fa-download" groups="tiendanube_connector.group_tn_manager"/>
                </header>
                <sheet>
                    <group>
                        <group string="Información General">
                            <field name="name" placeholder="Nombre de la cuenta"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="oauth_via_hub" invisible="1"/>
                            <field name="oauth_is_hub" invisible="1"/>
                        </group>
                        <group string="Credenciales de API">
                            <field name="client_id" password="True" placeholder="Client ID" groups="tiendanube_connector.group_tn_manager" invisible="oauth_via_hub and not oauth_is_hub"/>
                            <field name="client_secret" password="True" placeholder="Client Secret" groups="tiendanube_connector.group_tn_admin" invisible="oauth_via_hub and not oauth_is_hub"/>
                            <div class="alert alert-warning" role="alert" colspan="2" invisible="not oauth_via_hub or oauth_is_hub">
                                <p><strong>OAuth vía hub activo.</strong> Esta base usa el hub central para autorizar (parámetros <code>tiendanube_connector.oauth_hub_url</code> / <code>oauth_shared_secret</code>). No hace falta Client ID acá: el hub debe tenerlo. Si estás en sandbox y querés autorizar directo, vaciá esos dos parámetros del sistema.</p>
                            </div>
                            <div class="alert alert-info" role="alert" colspan="2" invisible="not oauth_is_hub">
                                <p><strong>Esta base es el hub OAuth.</strong> Cargá acá el Client ID y Client Secret de la app de TiendaNube. La Redirect URI en TN debe ser la de este Odoo.</p>
                            </div>
                            <field name="access_token" password="True" placeholder="Access Token" groups="tiendanube_connector.group_tn_admin"/>
                            <field name="refresh_token" password="True" placeholder="Refresh Token" groups="tiendanube_connector.group_tn_admin"/>
                        </group>
                        <group string="Configuración de Tienda">
                            <field name="store_id" placeholder="Store ID"/>
                            <field name="api_base_url" placeholder="https://api.tiendanube.com/v1"/>
                        </group>
                        <group string="País de la tienda (TiendaNube)" colspan="2">
                            <field name="tn_store_country_code" readonly="1"/>
                            <field name="tn_store_country_id" readonly="1" options="{'no_open': True}"/>
                            <field name="tn_store_main_currency" readonly="1"/>
                            <field name="tn_store_metadata_synced_at" readonly="1"/>
                            <div class="alert alert-info" role="alert" colspan="2">
                                <p><strong>Detectado automáticamente.</strong> El país y la moneda se obtienen de la API TiendaNube (recurso <code>GET /store</code>) al guardar token y Store ID, al crear la cuenta, tras OAuth o con «Actualizar país/moneda (API)». No se puede editar a mano.</p>
                                <p><strong>Uso en Odoo:</strong> al crear contactos desde pedidos TN se usa ese país para <code>res.partner.country_id</code> y para buscar la provincia/estado; el texto de país en la venta TN prioriza el envío del pedido y, si falta, el país de la tienda. Si la API aún no respondió, se usa Argentina como respaldo.</p>
                                <p><strong>Diferencias por país en el conector:</strong> hoy no hay ramas distintas por país más allá de usar el ISO correcto y los estados de <code>res.country.state</code> del país correspondiente. Facturación e impuestos siguen siendo los que configure en esta pantalla. El precio en TiendaNube se gestiona por publicación («Actualizar valores»), no desde una lista de precios de Odoo.</p>
                            </div>
                        </group>
                    </group>
                    <group string="Importación de publicaciones">
                        <group>
                            <field name="import_publications_active" readonly="1"/>
                            <field name="import_publications_page" readonly="1" invisible="not import_publications_active"/>
                            <field name="import_publications_batch_size" invisible="import_publications_active"/>
                            <field name="import_download_images" invisible="import_publications_active"/>
                            <field name="scan_new_publications_enabled" invisible="import_publications_active"/>
                            <field name="scan_new_publications_import_limit"
                                   invisible="not scan_new_publications_enabled or import_publications_active"/>
                            <field name="scan_new_publications_last_run" readonly="1"
                                   invisible="not scan_new_publications_enabled"/>
                            <field name="scan_new_publications_last_imported" readonly="1"
                                   invisible="not scan_new_publications_enabled"/>
                        </group>
                        <group>
                            <div class="alert alert-info" role="alert" invisible="import_publications_active">
                                <p><strong>Importación masiva:</strong> el catálogo completo se procesa en segundo plano (cron, ~1 lote por minuto). Cada producto se confirma en base de datos al instante; si se interrumpe, al reanudar se omiten los ya importados.</p>
                                <p><strong>Imágenes:</strong> desactivado = solo URLs (recomendado para ~3000 productos). Activado = descarga el binario (mucho más lento).</p>
                                <p><strong>Scan diario de novedades:</strong> una vez al día lista el catálogo TN (GET /products paginado) e importa solo productos que aún no están en Odoo. No corre durante una importación masiva activa.</p>
                            </div>
                            <div class="alert alert-warning" role="alert" invisible="not import_publications_active">
                                <p><strong>Importación en curso</strong> (página <field name="import_publications_page" readonly="1" nolabel="1" class="oe_inline"/>). Revise Publicaciones TiendaNube y los logs del servidor.</p>
                            </div>
                        </group>
                    </group>
                    <group string="Configuración del stock">
                        <group>
                            <field name="stock_location_id" options="{'no_create': True}" placeholder="Seleccionar almacén..."/>
                            <field name="stock_type"/>
                        </group>
                    </group>
                    <group string="Configuración de Ventas">
                        <group>
                            <field name="fallback_product_id" options="{'no_create': True}" placeholder="Seleccionar producto por defecto para errores SKU..."/>
                            <field name="auto_invoice_with_fallback_product"
                                   invisible="not fallback_product_id"/>
                            <div class="alert alert-info" role="alert" invisible="not auto_invoice_with_fallback_product">
                                <p><strong>Fallback facturable:</strong> ventas con SKU/publicación no identificada se confirman y facturan con el producto fallback; en el PDF aparece el nombre de TiendaNube. Requiere producto fallback y factura automática activos.</p>
                            </div>
                            <field name="default_tax_id" options="{'no_create': True}" placeholder="Seleccionar impuesto por defecto..."/>
                            <field name="warehouse_id" options="{'no_create': True}" placeholder="Seleccionar almacén predeterminado..."/>
                        </group>
                        <group string="Importación a Odoo">
                            <field name="auto_create_sale_order"/>
                            <field name="auto_invoice" invisible="not auto_create_sale_order"/>
                            <field name="invoice_journal_id" options="{'no_create': True}" placeholder="Seleccionar diario para facturas..." invisible="not auto_invoice"/>
                            <field name="default_income_account_id" options="{'no_create': True}" placeholder="Seleccionar cuenta de ingresos..." invisible="not auto_invoice"/>
                            <field name="consumidor_final_partner_id"
                                   options="{'no_create': True}"
                                   placeholder="Ej. Consumidor Final"
                                   required="auto_create_sale_order"/>
                            <field name="create_order_contacts"/>
                            <div class="alert alert-info" role="alert">
                                <p><strong>Facturación:</strong> órdenes de venta y facturas TN usan siempre el Consumidor Final.</p>
                                <p><strong>Crear contacto del comprador:</strong> opcional; guarda un <code>res.partner</code> con los datos del pedido (visible como «Comprador» en la venta TN) sin cambiar la factura.</p>
                            </div>
                        </group>
                    </group>
                    <group string="Webhook de Ventas">
                        <group>
                            <field name="webhook_id" readonly="1"/>
                            <field name="webhook_url" readonly="1"/>
                            <field name="webhook_expected_url" readonly="1"/>
                            <field name="webhook_url_mismatch" readonly="1" widget="boolean"/>
                            <field name="webhook_enabled"/>
                            <field name="webhook_last_received_at" readonly="1"/>
                            <field name="webhook_last_status" readonly="1"/>
                            <field name="webhook_last_summary" readonly="1"/>
                            <div class="alert alert-warning" role="alert" invisible="not webhook_url_mismatch">
                                <p><strong>URL desincronizada:</strong> el webhook en TiendaNube probablemente apunta a otra URL que no es la de este Odoo. Use «Verificar Webhook» o «Sincronizar Webhook» en el encabezado.</p>
                            </div>
                            <div class="alert alert-info" role="alert">
                                <p><strong>Diagnóstico webhook:</strong> en los logs buscar <code>[TN WEBHOOK][HEALTH]</code>. Prueba rápida: abrir en el navegador <code>/tiendanube/webhook/order</code> (debe loguear <code>status=ping</code>).</p>
                                <p>Los campos «Último webhook» se actualizan con cada POST de TiendaNube.</p>
                                <p><strong>Verificar / Sincronizar:</strong> compara la URL en TiendaNube con <code>web.base.url</code> y corrige si el ID 37557349 apunta a otro servidor.</p>
                                <p><strong>Procesar Webhooks:</strong> si está desactivado, se guarda la notificación pero no se importa la venta.</p>
                                <p><strong>Importar ventas / reintento:</strong> Use el botón del encabezado «Importar ventas / reintento webhook» para traer ventas por <em>últimas N horas</em> o por rango de fechas.</p>
                            </div>
                        </group>
                    </group>
                    <group string="Sincronización de Órdenes (Polling)">
                        <group>
                            <field name="polling_enabled"/>
                            <field name="order_polling_hours_back" invisible="not polling_enabled"/>
                            <field name="last_sync_date" readonly="1" invisible="not polling_enabled"/>
                            <field name="polling_orders_per_page" invisible="1"/>
                            <field name="polling_max_pages" invisible="1"/>
                            <field name="api_timeout_seconds" readonly="1" invisible="not polling_enabled"/>
                            <field name="api_max_retries" readonly="1" invisible="not polling_enabled"/>
                            <field name="cron_orders_active" readonly="1" invisible="not polling_enabled"/>
                            <field name="cron_orders_next_run" readonly="1" invisible="not polling_enabled"/>
                            <field name="cron_orders_last_run" readonly="1" invisible="not polling_enabled"/>
                            <div class="alert alert-info" role="alert" invisible="not polling_enabled">
                                <p><strong>Sincronización por Polling:</strong> El cron ejecuta cada 10 minutos y revisa las ventas creadas en TiendaNube en las <strong>últimas N horas</strong> (configurable arriba). Límite: 1 a 168 horas (7 días).</p>
                                <p><strong>Última Sincronización:</strong> Se actualiza después de cada ejecución exitosa.</p>
                                <p><strong>Idempotencia:</strong> Las órdenes duplicadas se detectan y se actualizan en lugar de crearse de nuevo.</p>
                            </div>
                            <div class="alert alert-warning" role="alert" invisible="polling_enabled">
                                <p><strong>Polling Desactivado:</strong> Solo se sincronizarán órdenes mediante webhooks. El cron no ejecutará la sincronización automática.</p>
                            </div>
                        </group>
                    </group>
                    <group string="Sincronización Automática desde Odoo">
                        <group>
                            <field name="auto_sync_stock_on_odoo_change"/>
                            <div class="alert alert-info" role="alert">
                                <p><strong>Sincronizar Stock Automáticamente desde Odoo:</strong> Si está activado, cuando se modifique el stock en Odoo (por ventas, compras, ajustes manuales, etc.), se sincronizará automáticamente el stock a TiendaNube.</p>
                                <p><strong>Importante:</strong> El stock se copia directamente (valor absoluto) desde Odoo a TiendaNube. No se suma ni resta, se reemplaza el valor anterior con el valor actual de Odoo.</p>
                                <p>Use «Ver Publicaciones que Sincronizarían Stock» para revisar la lista antes de activar.</p>
                            </div>
                        </group>
                    </group>
                    <group string="Control de Stock Mínimo">
                        <group>
                            <field name="enable_min_stock_pause"/>
                            <field name="global_min_stock_pause" invisible="not enable_min_stock_pause"/>
                            <div class="alert alert-info" role="alert" invisible="not enable_min_stock_pause">
                                <p><strong>Pausa Automática por Stock:</strong> Cuando está activada, las publicaciones se pausarán automáticamente cuando el stock total caiga por debajo del umbral de pausa configurado.</p>
                                <p><strong>Umbral Global:</strong> Este valor se aplica a todas las publicaciones que no tengan un umbral específico configurado. Las publicaciones pueden tener sus propios umbrales que sobrescriben este valor global.</p>
                                <p><strong>Regla:</strong> Si stock &lt; umbral_pausa → Publicación se pausa (published=False)</p>
                            </div>
                        </group>
                        <group>
                            <field name="enable_min_stock_unpause"/>
                            <field name="global_min_stock_unpause" invisible="not enable_min_stock_unpause"/>
                            <div class="alert alert-info" role="alert" invisible="not enable_min_stock_unpause">
                                <p><strong>Despausa Automática por Stock:</strong> Cuando está activada, las publicaciones se despausarán automáticamente cuando el stock total supere el umbral de despausa configurado.</p>
                                <p><strong>Umbral Global:</strong> Este valor se aplica a todas las publicaciones que no tengan un umbral específico configurado. Las publicaciones pueden tener sus propios umbrales que sobrescriben este valor global.</p>
                                <p><strong>Regla:</strong> Si stock ≥ umbral_despausa → Publicación se despausa (published=True)</p>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Información" name="info">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <h4>Configuración de TiendaNube</h4>
                                    <p>Conectá tu tienda para sincronizar publicaciones, stock y ventas. El precio en TiendaNube se actualiza desde cada publicación («Actualizar valores»).</p>
                                    <ul>
                                        <li><strong>Autorizar Aplicación</strong>: abre TiendaNube para vincular esta cuenta (recomendado)</li>
                                        <li><strong>Access Token / Refresh Token</strong>: se completan solos después de autorizar</li>
                                        <li><strong>Store ID</strong>: ID de tu tienda (se completa al autorizar)</li>
                                        <li><strong>API Base URL</strong>: por defecto https://api.tiendanube.com/v1</li>
                                    </ul>
                                    <p><strong>Pasos:</strong></p>
                                    <ol>
                                        <li>Haz clic en <strong>"Autorizar Aplicación"</strong> e iniciá sesión en TiendaNube</li>
                                        <li>Usa <strong>"Probar Conexión"</strong> para validar</li>
                                    </ol>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de menú -->
    <record id="action_tn_config" model="ir.actions.server">
        <field name="name">Configuración TiendaNube</field>
        <field name="model_id" ref="model_tn_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_config()</field>
    </record>

</odoo>

