<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de configuración -->
    <record id="res_config_settings_view_form_inherit_tn" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.tn</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="TiendaNube" string="TiendaNube" data-key="tiendanube_connector">
                    <h2>Credenciales de TiendaNube</h2>
                    <div class="row mt16 o_settings_container">
                        <!-- Client ID -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="tn_client_id" string="Client ID"/>
                                <field name="tn_client_id" password="True" placeholder="Client ID"/>
                                <div class="text-muted">
                                    Client ID de tu aplicación TiendaNube
                                </div>
                            </div>
                        </div>
                        
                        <!-- Client Secret -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="tn_client_secret" string="Client Secret"/>
                                <field name="tn_client_secret" password="True" placeholder="Client Secret"/>
                                <div class="text-muted">
                                    Client Secret de tu aplicación TiendaNube
                                </div>
                            </div>
                        </div>
                        
                        <!-- Access Token -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="tn_access_token" string="Access Token"/>
                                <field name="tn_access_token" password="True" placeholder="Access Token"/>
                                <div class="text-muted">
                                    Token de acceso de TiendaNube
                                </div>
                            </div>
                        </div>
                        
                        <!-- Refresh Token -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="tn_refresh_token" string="Refresh Token"/>
                                <field name="tn_refresh_token" password="True" placeholder="Refresh Token"/>
                                <div class="text-muted">
                                    Token para renovar el Access Token
                                </div>
                            </div>
                        </div>
                        
                        <!-- Store ID -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="tn_store_id" string="Store ID"/>
                                <field name="tn_store_id" placeholder="Store ID"/>
                                <div class="text-muted">
                                    ID de tu tienda en TiendaNube
                                </div>
                            </div>
                        </div>
                        
                        <!-- API Base URL -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="tn_api_base_url" string="API Base URL"/>
                                <field name="tn_api_base_url" placeholder="https://api.tiendanube.com/v1"/>
                                <div class="text-muted">
                                    URL base de la API de TiendaNube
                                </div>
                            </div>
                        </div>
                        
                        <!-- Endpoint de prueba webhook (solo admin) -->
                        <div class="col-12 col-lg-6 o_setting_box" groups="tiendanube_connector.group_tn_admin">
                            <div class="o_setting_left_pane">
                                <field name="tn_webhook_test_endpoint_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="tn_webhook_test_endpoint_enabled"/>
                                <div class="text-muted">
                                    Solo usuarios administradores. Requiere sesión en Odoo. Desactivado por defecto: activar solo en entornos de prueba.
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <button name="action_test_connection" string="Probar Conexión" type="object" class="btn-primary" icon="fa-plug"/>
                                <button name="action_refresh_token" string="Refrescar Token" type="object" class="btn-secondary" icon="fa-refresh"/>
                                <div class="text-muted mt-2">
                                    <p>Usa "Probar Conexión" para validar tus credenciales haciendo un GET /products?page=1</p>
                                    <p>Los valores se guardan automáticamente al hacer clic en "Guardar" en la parte superior.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>

