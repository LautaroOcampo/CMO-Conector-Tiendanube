<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista -->
    <record id="view_tn_publication_list" model="ir.ui.view">
        <field name="name">tn.publication.list</field>
        <field name="model">tn.publication</field>
        <field name="arch" type="xml">
            <list string="Publicaciones TiendaNube" decoration-muted="not published">
                <field name="title"/>
                <field name="tn_product_id"/>
                <field name="variant_ids" column_invisible="1"/>
                <field name="current_price_tn" string="Precio TN"/>
                <field name="current_stock_tn" string="Stock TN"/>
                <field name="odoo_product_id"/>
                <field name="odoo_variant_display_id" string="Variante Odoo" optional="hide"/>
                <field name="published" column_invisible="1"/>
                <!-- Activar: solo visible cuando está pausada -->
                <button name="action_activate_on_tn"
                        string="🔵 Activar"
                        type="object"
                        class="btn-primary"
                        invisible="published or not tn_product_id"/>
                <!-- Pausar: solo visible cuando está activa -->
                <button name="action_pause_on_tn"
                        string="⏸️ Pausar"
                        type="object"
                        class="btn-secondary"
                        invisible="not published or not tn_product_id"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_tn_publication_form" model="ir.ui.view">
        <field name="name">tn.publication.form</field>
        <field name="model">tn.publication</field>
        <field name="arch" type="xml">
            <form string="Publicación TiendaNube">
                <header>
                    <button name="action_export_to_tn" string="Exportar a TiendaNube" type="object" class="btn-primary" icon="fa-cloud-upload"/>
                    <button name="action_open_tn_values_wizard" string="Actualizar valores" type="object" class="btn-primary" icon="fa-edit"
                            help="Abre un asistente para enviar título, precio, stock, SKU, imágenes y demás datos a TiendaNube (requiere producto ya exportado)."/>
                    <button name="action_auto_link_products_by_sku" string="Auto-relacionar por SKU" type="object" class="btn-secondary" icon="fa-link"/>
                    <field name="sync_state" widget="statusbar" statusbar_visible="draft,pending,synced" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Características">
                            <field name="title" readonly="1"/>
                            <field name="handle" readonly="1"/>
                            <field name="sku" readonly="1"/>
                            <field name="barcode" readonly="1"/>
                            <field name="tn_config_id" options="{'no_create': True}" required="1" readonly="1"/>
                            <field name="odoo_product_id"/>
                            <field name="show_odoo_variant_field" invisible="1"/>
                            <field name="odoo_variant_display_id" optional="show" options="{'no_create': True}" invisible="not show_odoo_variant_field" readonly="1"/>
                            <field name="tn_product_id" readonly="1"/>
                            <field name="published" readonly="1"/>
                            <field name="marca" readonly="1"/>
                            <field name="categoria_ids" widget="many2many_tags" readonly="1"/>
                            <field name="tag_ids" widget="many2many_tags" readonly="1"/>
                        </group>

                        <group string="Precio y Stock (TiendaNube)">
                            <field name="current_price_tn" string="Precio" readonly="1"/>
                            <field name="current_stock_tn" string="Stock" readonly="1"/>
                            <field name="has_auto_sync" invisible="1"/>
                            <div class="alert alert-info" role="alert" colspan="2" invisible="not has_auto_sync">
                                <p><strong>ℹ️ Sincronización automática activada:</strong> los cambios en Odoo se envían a TiendaNube según la configuración de la cuenta. Los importes anteriores reflejan la publicación en Odoo (variantes / última sincronización).</p>
                            </div>
                        </group>
                        <group string="Control de Stock Mínimo" invisible="not tn_config_id">
                            <group>
                                <field name="enable_min_stock_pause"/>
                                <field name="min_stock_pause" invisible="not enable_min_stock_pause" placeholder="Si está vacío, se usa el valor global"/>
                                <div class="alert alert-info" role="alert" invisible="not enable_min_stock_pause">
                                    <p><strong>Pausa Automática:</strong> Si está activada, esta publicación se pausará cuando el stock caiga por debajo del umbral. Si está desactivada, se usará la configuración global.</p>
                                    <p><strong>Umbral Específico:</strong> Si está configurado, sobrescribe el umbral global. Si está vacío, se usa el valor global.</p>
                                </div>
                            </group>
                            <group>
                                <field name="enable_min_stock_unpause"/>
                                <field name="min_stock_unpause" invisible="not enable_min_stock_unpause" placeholder="Si está vacío, se usa el valor global"/>
                                <div class="alert alert-info" role="alert" invisible="not enable_min_stock_unpause">
                                    <p><strong>Despausa Automática:</strong> Si está activada, esta publicación se despausará cuando el stock supere el umbral. Si está desactivada, se usará la configuración global.</p>
                                    <p><strong>Umbral Específico:</strong> Si está configurado, sobrescribe el umbral global. Si está vacío, se usa el valor global.</p>
                                </div>
                            </group>
                        </group>

                        <group string="Dimensiones">
                            <field name="weight" string="Peso (kg)" readonly="1"/>
                            <field name="width" string="Ancho (cm)" readonly="1"/>
                            <field name="height" string="Alto (cm)" readonly="1"/>
                            <field name="depth" string="Profundidad (cm)" readonly="1"/>
                        </group>

                    </group>

                    <notebook>
                        <page string="Descripción" name="description">
                            <field name="description" widget="html" readonly="1"/>
                            <field name="description_text" invisible="1"/>
                        </page>
                        <page string="Imágenes" name="images">
                            <field name="image_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="name" readonly="1"/>
                                    <field name="position" readonly="1"/>
                                    <field name="image" widget="image" class="oe_avatar" readonly="1"/>
                                    <field name="image_url" readonly="1"/>
                                </list>
                                <form edit="0" create="0" delete="0">
                                    <group>
                                        <field name="name" readonly="1"/>
                                        <field name="position" readonly="1"/>
                                        <field name="image" widget="image" readonly="1"/>
                                        <field name="image_url" readonly="1"/>
                                        <field name="tn_image_id" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Variantes" name="variants">
                            <div class="alert alert-info" role="alert" invisible="not odoo_product_id">
                                <strong>💡</strong> Las variantes se toman automáticamente del producto de Odoo relacionado.
                            </div>
                            <field name="variant_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="odoo_variant_id" string="Variante Odoo" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="sku" readonly="1"/>
                                    <field name="price" readonly="1"/>
                                    <field name="stock" readonly="1"/>
                                </list>
                                <form edit="0" create="0" delete="0">
                                    <group>
                                        <group>
                                            <field name="odoo_variant_id" options="{'no_create': True}" 
                                                   placeholder="Seleccione una variante de Odoo para matchear atributos" readonly="1"/>
                                            <field name="name" placeholder="Nombre de la variante (se completa automáticamente)" readonly="1"/>
                                            <field name="price" readonly="1"/>
                                            <field name="stock" readonly="1"/>
                                            <field name="sku" placeholder="SKU de la variante" readonly="1"/>
                                            <field name="barcode" placeholder="Código de barras" readonly="1"/>
                                        </group>
                                        <group>
                                            <field name="option1_name" placeholder="Nombre (ej: Talla)" 
                                                   readonly="1" invisible="not odoo_variant_id"/>
                                            <field name="option1_value" placeholder="Valor (ej: M)" 
                                                   readonly="1" invisible="not odoo_variant_id"/>
                                            <field name="option2_name" placeholder="Nombre (ej: Color)" 
                                                   readonly="1" invisible="not odoo_variant_id"/>
                                            <field name="option2_value" placeholder="Valor (ej: Rojo)" 
                                                   readonly="1" invisible="not odoo_variant_id"/>
                                            <field name="option3_name" placeholder="Nombre" 
                                                   readonly="1" invisible="not odoo_variant_id"/>
                                            <field name="option3_value" placeholder="Valor" 
                                                   readonly="1" invisible="not odoo_variant_id"/>
                                            <field name="tn_variant_id" readonly="1"/>
                                        </group>
                                        <group string="Dimensiones y Medidas">
                                            <field name="weight" string="Peso (kg)" readonly="1"/>
                                            <field name="width" string="Ancho (cm)" readonly="1"/>
                                            <field name="height" string="Alto (cm)" readonly="1"/>
                                            <field name="depth" string="Profundidad (cm)" readonly="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Campos personalizados" name="attributes">
                            <field name="attribute_ids" nolabel="1" readonly="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="sequence" widget="handle" readonly="1"/>
                                    <field name="name" string="Nombre del campo" readonly="1"/>
                                    <field name="value" string="Valor" readonly="1"/>
                                </list>
                                <form edit="0" create="0" delete="0">
                                    <group>
                                        <field name="name" string="Nombre del campo" readonly="1"/>
                                        <field name="value" string="Valor" readonly="1"/>
                                        <field name="sequence" readonly="1"/>
                                        <field name="tn_custom_field_id" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Errores" name="errors" invisible="sync_state != 'error'">
                            <group>
                                <field name="sync_error_message" nolabel="1" widget="text" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_tn_publication_search" model="ir.ui.view">
        <field name="name">tn.publication.search</field>
        <field name="model">tn.publication</field>
        <field name="arch" type="xml">
            <search string="Buscar Publicaciones">
                <field name="title" string="Título"/>
                <field name="tn_product_id" string="ID TiendaNube"/>
                <field name="odoo_product_id" string="Producto Odoo"/>
                <separator/>
                <filter string="Con producto Odoo" name="with_odoo_product" domain="[('odoo_product_id', '!=', False)]"/>
                <filter string="Sincronizados" name="synced" domain="[('sync_state', '=', 'synced')]"/>
                <filter string="Pendientes" name="pending" domain="[('sync_state', '=', 'pending')]"/>
                <filter string="Con Error" name="error" domain="[('sync_state', '=', 'error')]"/>
                <filter string="Publicados" name="published" domain="[('published', '=', True)]"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Estado" name="group_sync_state" context="{'group_by': 'sync_state'}"/>
                    <filter string="Producto Odoo" name="group_odoo_product" context="{'group_by': 'odoo_product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de menú -->
    <record id="action_tn_publication" model="ir.actions.act_window">
        <field name="name">Publicaciones TiendaNube</field>
        <field name="res_model">tn.publication</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_with_odoo_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera publicación de TiendaNube
            </p>
            <p>
                Las publicaciones son productos sincronizados entre Odoo y TiendaNube.
                Puedes importar productos desde TiendaNube o exportar productos de Odoo.
            </p>
        </field>
    </record>


    <!-- Acciones masivas en lista de publicaciones -->
    <record id="action_mass_activate_publications" model="ir.actions.server">
        <field name="name">Activar publicaciones</field>
        <field name="model_id" ref="model_tn_publication"/>
        <field name="binding_model_id" ref="model_tn_publication"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_activate_on_tn()</field>
    </record>
    <record id="action_mass_pause_publications" model="ir.actions.server">
        <field name="name">Pausar publicaciones</field>
        <field name="model_id" ref="model_tn_publication"/>
        <field name="binding_model_id" ref="model_tn_publication"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_pause_on_tn()</field>
    </record>

    <!-- Menú principal -->
    <menuitem id="menu_tn_publication_root"
              name="TiendaNube"
              sequence="100"
              web_icon="tiendanube_connector,static/description/icon.png"
              groups="tiendanube_connector.group_tn_user"/>

    <menuitem id="menu_tn_config"
              name="Configuración"
              parent="menu_tn_publication_root"
              action="action_tn_config"
              sequence="5"/>

    <menuitem id="menu_tn_publication"
              name="Publicaciones"
              parent="menu_tn_publication_root"
              action="action_tn_publication"
              sequence="10"/>

    <!-- Vista heredada de product.template para agregar pestaña TiendaNube -->
    <record id="view_product_template_form_inherit_tn" model="ir.ui.view">
        <field name="name">product.template.form.inherit.tn</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Pestaña TiendaNube dentro del notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="TiendaNube" name="tiendanube" groups="tiendanube_connector.group_tn_user">
                    <group string="Publicaciones TiendaNube">
                        <field name="tn_publication_ids" 
                               context="{'default_odoo_product_id': id}"
                               nolabel="1">
                            <list>
                                <field name="title"/>
                                <field name="tn_product_id" string="ID TiendaNube"/>
                                <field name="sync_state" widget="badge" decoration-success="sync_state == 'synced'" decoration-warning="sync_state == 'pending'" decoration-danger="sync_state == 'error'"/>
                                <field name="published"/>
                                <field name="last_sync_date"/>
                            </list>
                            <form>
                                <sheet>
                                    <group>
                                        <group>
                                            <field name="title"/>
                                            <field name="odoo_product_id" invisible="1"/>
                                            <field name="tn_product_id" readonly="1"/>
                                            <field name="sync_state" widget="statusbar" statusbar_visible="draft,pending,synced"/>
                                        </group>
                                        <group>
                                            <field name="published"/>
                                            <field name="marca"/>
                                            <field name="last_sync_date" readonly="1"/>
                                        </group>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
