<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tn_import_orders_wizard_form" model="ir.ui.view">
        <field name="name">tn.import.orders.wizard.form</field>
        <field name="model">tn.import.orders.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Órdenes de TiendaNube">
                <sheet>
                    <group>
                        <field name="tn_config_id" readonly="1"/>
                    </group>
                    <group string="Rango de fechas">
                        <field name="date_from" placeholder="Ej: 01/01/2025"/>
                        <field name="date_to" placeholder="Ej: 26/01/2025 (opcional)"/>
                    </group>
                    <group>
                        <div class="alert alert-info" role="alert">
                            <p>
                                Se importarán las ventas de TiendaNube creadas entre las fechas indicadas.
                                Si no se indica "Hasta fecha", se consideran hasta hoy.
                            </p>
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import_orders"
                            string="Importar Órdenes"
                            type="object"
                            class="oe_highlight"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
