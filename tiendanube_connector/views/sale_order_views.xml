<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista heredada de sale.order para agregar smart button de TiendaNube -->
    <record id="view_order_form_inherit_tn" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tn</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Agregar smart button en el button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_tn_sale_order" 
                        icon="fa-shopping-bag" invisible="not tn_sale_order_id">
                    <span class="o_stat_text">TiendaNube</span>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

