<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tn_oauth_tenant_list" model="ir.ui.view">
        <field name="name">tn.oauth.tenant.list</field>
        <field name="model">tn.oauth.tenant</field>
        <field name="arch" type="xml">
            <list string="Bases conectadas">
                <field name="name"/>
                <field name="code"/>
                <field name="base_url"/>
                <field name="active"/>
                <field name="last_authorized_at"/>
                <field name="last_error"/>
            </list>
        </field>
    </record>

    <record id="view_tn_oauth_tenant_form" model="ir.ui.view">
        <field name="name">tn.oauth.tenant.form</field>
        <field name="model">tn.oauth.tenant</field>
        <field name="arch" type="xml">
            <form string="Base conectada">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="base_url"/>
                            <field name="last_authorized_at" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tn_oauth_tenant" model="ir.actions.act_window">
        <field name="name">Bases conectadas</field>
        <field name="res_model">tn.oauth.tenant</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
