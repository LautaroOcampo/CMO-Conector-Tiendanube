<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_groups_privilege_tiendanube" model="res.groups.privilege">
            <field name="name">TiendaNube</field>
            <field name="sequence">51</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="placeholder">Sin acceso</field>
        </record>

        <record id="group_tn_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_tiendanube"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Ve publicaciones y ventas. No ve la configuración, las credenciales ni las acciones de administración.</field>
        </record>

        <record id="group_tn_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="res_groups_privilege_tiendanube"/>
            <field name="implied_ids" eval="[(4, ref('group_tn_user'))]"/>
            <field name="comment">Acceso completo, incluida la administración de la tienda.</field>
        </record>
    </data>
</odoo>
