<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista heredada de sale.order: smart button + pestaña TiendaNube -->
    <record id="view_order_form_inherit_tn" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.tn</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_tn_sale_order"
                        icon="fa-shopping-bag" invisible="not tn_sale_order_id"
                        groups="tiendanube_connector.group_tn_user">
                    <span class="o_stat_text">TiendaNube</span>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="TiendaNube" name="tn_sale_page"
                      invisible="not tn_sale_order_id"
                      groups="tiendanube_connector.group_tn_user">
                    <group>
                        <group string="Venta vinculada">
                            <field name="tn_sale_order_id" string="Venta TN" readonly="1"/>
                            <field name="tn_order_id" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
