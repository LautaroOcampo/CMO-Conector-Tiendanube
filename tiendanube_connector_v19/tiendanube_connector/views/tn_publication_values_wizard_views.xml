<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tn_publication_values_wizard_form" model="ir.ui.view">
        <field name="name">tn.publication.values.wizard.form</field>
        <field name="model">tn.publication.values.wizard</field>
        <field name="arch" type="xml">
            <form string="Actualizar valores en TiendaNube">
                <sheet>
                    <group>
                        <field name="publication_id" invisible="1"/>
                        <field name="title_tn"/>
                        <field name="price"/>
                        <field name="stock"/>
                        <field name="sku"/>
                        <field name="barcode"/>
                        <field name="marca"/>
                        <field name="categoria_ids" widget="many2many_tags"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Imágenes">
                        <field name="image_line_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="image" widget="image"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object" string="Actualizar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
