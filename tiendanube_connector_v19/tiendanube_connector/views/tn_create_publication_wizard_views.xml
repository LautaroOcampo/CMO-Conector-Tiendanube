<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de búsqueda para productos en el wizard -->
    <record id="view_product_template_search_wizard" model="ir.ui.view">
        <field name="name">product.template.search.wizard</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Buscar Productos">
                <field name="name" string="Nombre"/>
                <field name="default_code" string="SKU"/>
                <field name="categ_id" string="Categoría"/>
                <filter string="Sin Publicación TN" name="no_tn_publication" domain="[('has_tn_publication', '=', False)]"/>
                <filter string="Con Publicación TN" name="with_tn_publication" domain="[('has_tn_publication', '=', True)]"/>
                <separator/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Vista de lista para seleccionar productos -->
    <record id="view_product_template_list_wizard" model="ir.ui.view">
        <field name="name">product.template.list.wizard</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Productos" decoration-info="not has_tn_publication">
                <field name="image_128" widget="image" class="oe_avatar"/>
                <field name="name"/>
                <field name="default_code" string="SKU"/>
                <field name="categ_id"/>
                <field name="list_price" string="Precio"/>
                <field name="qty_available" string="Stock"/>
                <field name="has_tn_publication" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario del wizard -->
    <record id="view_tn_create_publication_wizard_form" model="ir.ui.view">
        <field name="name">tn.create.publication.wizard.form</field>
        <field name="model">tn.create.publication.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear Publicaciones en TiendaNube">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Crear Publicaciones desde Productos de Odoo</span>
                        </h1>
                    </div>
                    <group>
                        <field name="tn_config_id" options="{'no_create': True}" required="1"/>
                    </group>
                    <notebook>
                        <page string="Seleccionar Productos" name="products">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <p><strong>Instrucciones:</strong></p>
                                    <ul>
                                        <li>Seleccione la cuenta de TiendaNube a usar</li>
                                        <li>Haga clic en "Agregar una línea" o en el campo de búsqueda para abrir el selector de productos</li>
                                        <li>Use el buscador de productos con todos los filtros disponibles (categoría, SKU, nombre, etc.)</li>
                                        <li>Seleccione los productos que desea publicar</li>
                                        <li>Puede agregar múltiples productos haciendo clic varias veces en "Agregar una línea"</li>
                                        <li>Los productos seleccionados aparecerán en la lista debajo</li>
                                    </ul>
                                </div>
                            </group>
                            <field name="product_ids" 
                                   nolabel="1"
                                   domain="[('active', '=', True), ('has_tn_publication', '=', False)]"
                                   context="{'search_default_no_tn_publication': 1, 'search_default_active': 1, 'default_active': True}"
                                   options="{'no_create': True, 'no_create_edit': True}">
                                <list string="Productos Seleccionados" 
                                      create="1" 
                                      edit="0" 
                                      delete="1"
                                      default_order="name">
                                    <field name="image_128" widget="image" class="oe_avatar"/>
                                    <field name="name" string="Nombre"/>
                                    <field name="default_code" string="SKU"/>
                                    <field name="categ_id" string="Categoría"/>
                                    <field name="list_price" string="Precio"/>
                                    <field name="qty_available" string="Stock"/>
                                </list>
                            </field>
                        </page>
                        <page string="Información" name="info">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <p><strong>Datos que se copiarán a la publicación:</strong></p>
                                    <ul>
                                        <li><strong>Nombre:</strong> Nombre del producto (product.template.name)</li>
                                        <li><strong>Precio:</strong> Precio de lista del producto (list_price) al crear; luego se gestiona desde la publicación</li>
                                        <li><strong>Stock:</strong> Stock disponible en el almacén configurado</li>
                                        <li><strong>Imagen:</strong> Imagen principal del producto (image_1920)</li>
                                        <li><strong>SKU:</strong> Código de producto (default_code)</li>
                                        <li><strong>Descripción:</strong> Descripción del producto</li>
                                        <li><strong>Tags:</strong> Tags del producto (product_tag_ids)</li>
                                        <li><strong>Variantes:</strong> Variantes del producto (si tiene)</li>
                                        <li><strong>Categoría:</strong> Categoría del producto (categ_id)</li>
                                    </ul>
                                    <p>Las publicaciones se crearán en estado <strong>Borrador</strong> y se exportarán automáticamente a TiendaNube</p>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_publications" string="Crear Publicaciones" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del wizard - Aparece en la lista de productos -->
    <record id="action_tn_create_publication_wizard" model="ir.actions.act_window">
        <field name="name">Crear Publicaciones en TiendaNube</field>
        <field name="res_model">tn.create.publication.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>

