<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDF: nombre TiendaNube en líneas con producto fallback. -->
    <template id="report_invoice_document_tn_line_name" inherit_id="account.report_invoice_document">
        <xpath expr="//td[@name='account_invoice_line_name']/span" position="replace">
            <span t-if="line.get_channel_invoice_report_line_name()"
                  t-out="line.get_channel_invoice_report_line_name()"
                  t-options="{'widget': 'text'}"
                  dir="auto"/>
        </xpath>
    </template>

    <template id="report_invoice_document_ar_tn_line_name" inherit_id="l10n_ar.report_invoice_document">
        <xpath expr="//td[@name='account_invoice_line_name']/span" position="replace">
            <span t-if="line.get_channel_invoice_report_line_name()"
                  t-out="line.get_channel_invoice_report_line_name()"
                  t-options="{'widget': 'text'}"
                  dir="auto"/>
        </xpath>
    </template>
</odoo>
