<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job para sincronizar órdenes de TiendaNube mediante polling -->
        <record id="ir_cron_sync_orders_tiendanube" model="ir.cron">
            <field name="name">Sincronizar Órdenes de TiendaNube (Polling)</field>
            <field name="model_id" ref="model_tn_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_orders_by_polling()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
    </data>
    <record id="ir_cron_purge_tn_sync_logs" model="ir.actions.server">
    <field name="name">TN: Purgar logs de sync OK (&gt;30 días)</field>
    <field name="model_id" ref="model_tn_sync_log"/>
    <field name="state">code</field>
    <field name="code">model.cron_purge_old_ok_logs()</field>
</record>
<record id="ir_cron_purge_tn_sync_logs_trigger" model="ir.cron">
    <field name="name">TN: Purgar logs de sync OK</field>
    <field name="model_id" ref="model_tn_sync_log"/>
    <field name="state">code</field>
    <field name="code">model.cron_purge_old_ok_logs()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">months</field>
    <field name="active">True</field>
</record>
</odoo>
