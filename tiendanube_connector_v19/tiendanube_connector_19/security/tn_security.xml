<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Usuario TN: consulta publicaciones, ventas TN, notificaciones (solo lectura en lo sensible). -->
        <record id="group_tn_user" model="res.groups">
            <field name="name">Usuario TiendaNube</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Gestor TN: operaciones (importar, sincronizar, webhooks, configuración sin secretos críticos). -->
        <record id="group_tn_manager" model="res.groups">
            <field name="name">Gestor TiendaNube</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_tn_user'))]"/>
        </record>

        <!-- Administrador TN: credenciales API, tokens y borrado de configuración. -->
        <record id="group_tn_admin" model="res.groups">
            <field name="name">Administrador TiendaNube</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_tn_manager'))]"/>
        </record>
    </data>
</odoo>
