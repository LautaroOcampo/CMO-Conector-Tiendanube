<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job para sincronizar stock pendiente con TiendaNube -->
        <record id="ir_cron_sync_stock_tiendanube" model="ir.cron">
            <field name="name">Sincronizar Stock con TiendaNube</field>
            <field name="model_id" ref="model_tn_publication"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_stock_to_tiendanube()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>

