<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tn_sync_log_tree" model="ir.ui.view">
        <field name="name">tn.sync.log.tree</field>
        <field name="model">tn.sync.log</field>
        <field name="arch" type="xml">
            <list string="Auditoría sincronización TN" create="false" edit="false" delete="false">
                <field name="create_date"/>
                <field name="tn_config_id"/>
                <field name="publication_id"/>
                <field name="operation"/>
                <field name="trigger"/>
                <field name="result"/>
                <field name="http_status"/>
                <field name="duration_ms"/>
                <field name="value_before" optional="hide"/>
                <field name="value_after" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tn_sync_log_form" model="ir.ui.view">
        <field name="name">tn.sync.log.form</field>
        <field name="model">tn.sync.log</field>
        <field name="arch" type="xml">
            <form string="Registro de sincronización" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="tn_config_id"/>
                            <field name="publication_id"/>
                            <field name="operation"/>
                            <field name="trigger"/>
                        </group>
                        <group>
                            <field name="result"/>
                            <field name="http_status"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group string="Valores">
                        <field name="value_before" colspan="2"/>
                        <field name="value_after" colspan="2"/>
                    </group>
                    <group string="Error" invisible="result != 'error'">
                        <field name="error_message" colspan="2" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tn_sync_log_search" model="ir.ui.view">
        <field name="name">tn.sync.log.search</field>
        <field name="model">tn.sync.log</field>
        <field name="arch" type="xml">
            <search string="Auditoría TN">
                <field name="tn_config_id"/>
                <field name="publication_id"/>
                <field name="operation"/>
                <field name="result"/>
                <filter string="Errores" name="filter_error" domain="[('result', '=', 'error')]"/>
                <filter string="Exitosos" name="filter_ok" domain="[('result', '=', 'ok')]"/>
                <separator/>
                <filter string="Stock" name="op_stock" domain="[('operation', '=', 'stock_update')]"/>
                <filter string="Precio" name="op_price" domain="[('operation', '=', 'price_update')]"/>
                <filter string="Exportación" name="op_export" domain="[('operation', '=', 'export')]"/>
                <filter string="Catálogo (import)" name="op_product_import" domain="[('operation', '=', 'product_import')]"/>
                <filter string="Órdenes" name="op_order" domain="[('operation', '=', 'order_import')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cuenta TN" name="group_config" context="{'group_by': 'tn_config_id'}"/>
                    <filter string="Operación" name="group_op" context="{'group_by': 'operation'}"/>
                    <filter string="Resultado" name="group_result" context="{'group_by': 'result'}"/>
                    <filter string="Día" name="group_day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tn_sync_log" model="ir.actions.act_window">
        <field name="name">Auditoría sincronización</field>
        <field name="res_model">tn.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_tn_sync_log_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay registros de sincronización con TiendaNube.
            </p>
            <p>
                Se generan al sincronizar stock, precio, exportación, lectura de órdenes, etc.
            </p>
        </field>
    </record>

    <menuitem id="menu_tn_sync_log"
              name="Auditoría sincronización"
              parent="menu_tn_publication_root"
              action="action_tn_sync_log"
              sequence="45"
              groups="tiendanube_connector.group_tn_manager"/>
</odoo>
