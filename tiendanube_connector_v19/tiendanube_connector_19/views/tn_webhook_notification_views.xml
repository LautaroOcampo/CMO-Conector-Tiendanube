<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista de notificaciones de webhook -->
    <record id="view_tn_webhook_notification_list" model="ir.ui.view">
        <field name="name">tn.webhook.notification.list</field>
        <field name="model">tn.webhook.notification</field>
        <field name="arch" type="xml">
            <list string="Notificaciones Webhook" create="false" delete="false">
                <field name="order_id"/>
                <field name="event_type"/>
                <field name="date_received"/>
                <field name="status"/>
                <field name="tn_config_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Formulario de notificación (solo lectura para consulta) -->
    <record id="view_tn_webhook_notification_form" model="ir.ui.view">
        <field name="name">tn.webhook.notification.form</field>
        <field name="model">tn.webhook.notification</field>
        <field name="arch" type="xml">
            <form string="Notificación Webhook" create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="date_received" readonly="1"/>
                            <field name="status" readonly="1"/>
                        </group>
                        <group>
                            <field name="tn_config_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Datos Raw" invisible="not raw_data">
                        <field name="raw_data" readonly="1" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_tn_webhook_notification" model="ir.actions.act_window">
        <field name="name">Notificaciones Webhook</field>
        <field name="res_model">tn.webhook.notification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay notificaciones de webhook aún.
            </p>
            <p>
                Las notificaciones se crean cuando TiendaNube envía un aviso de venta al endpoint del webhook.
                El procesamiento real de órdenes lo hace el cron de sincronización (polling).
            </p>
        </field>
    </record>

    <!-- Menú bajo TiendaNube -->
    <menuitem id="menu_tn_webhook_notification"
              name="Notificaciones Webhook"
              parent="tiendanube_connector.menu_tn_publication_root"
              action="action_tn_webhook_notification"
              sequence="25"/>
</odoo>
