<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action para ver líneas (stat button) - Debe estar antes de usarse en el formulario -->
    <record id="action_view_lines" model="ir.actions.act_window">
        <field name="name">Líneas de Venta</field>
        <field name="res_model">tn.sale.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('order_id', '=', active_id)]</field>
        <field name="context">{'default_order_id': active_id}</field>
    </record>

    <!-- List View: Lista de Ventas -->
    <record id="view_tn_sale_order_tree" model="ir.ui.view">
        <field name="name">tn.sale.order.tree</field>
        <field name="model">tn.sale.order</field>
        <field name="arch" type="xml">
            <list string="Ventas TiendaNube" decoration-info="status == 'open'" decoration-success="status == 'closed'" decoration-muted="status == 'cancelled'">
                <field name="name"/>
                <field name="tn_order_id"/>
                <field name="date_created"/>
                <field name="customer_name"/>
                <field name="tn_customer_id" optional="hide"/>
                <field name="total" sum="Total"/>
                <field name="currency_id" invisible="1"/>
                <field name="shipping_cost"/>
                <field name="fulfillment_status"/>
                <field name="status"/>
                <field name="payment_status"/>
            </list>
        </field>
    </record>

    <!-- Form View: Formulario de Venta -->
    <record id="view_tn_sale_order_form" model="ir.ui.view">
        <field name="name">tn.sale.order.form</field>
        <field name="model">tn.sale.order</field>
        <field name="arch" type="xml">
            <form string="Venta TiendaNube">
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_contact" icon="fa-user"
                                invisible="not partner_id">
                            <span class="o_stat_text">Contacto</span>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_publication" icon="fa-cube">
                            <span class="o_stat_text">Publicación</span>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_odoo_sale_order" icon="fa-shopping-cart" 
                                invisible="not odoo_sale_order_id">
                            <span class="o_stat_text">Orden de Venta</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="tn_order_id"/>
                            <field name="status"/>
                            <field name="payment_status"/>
                            <field name="date_created"/>
                            <field name="date_closed"/>
                            <field name="origin"/>
                        </group>
                        <group>
                            <field name="total"/>
                            <field name="currency_id"/>
                            <field name="shipping_cost"/>
                            <field name="fulfillment_status"/>
                            <field name="odoo_sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cliente" name="customer">
                            <group>
                                <group string="Información del Cliente">
                                    <field name="customer_name" readonly="1"/>
                                    <field name="customer_email" readonly="1"/>
                                    <field name="customer_phone" readonly="1"/>
                                    <field name="customer_dni" readonly="1"/>
                                    <field name="tn_customer_id" readonly="1" optional="hide"/>
                                </group>
                            </group>
                        </page>
                        <page string="Dirección de Envío" name="shipping">
                            <group>
                                <group string="Dirección">
                                    <field name="shipping_street" readonly="1"/>
                                    <field name="shipping_street_number" readonly="1"/>
                                    <field name="shipping_city" readonly="1"/>
                                    <field name="shipping_state" readonly="1"/>
                                    <field name="shipping_country" readonly="1"/>
                                    <field name="shipping_zip" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Líneas de Venta" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="publication_id"/>
                                    <field name="publication_variant_id"/>
                                    <field name="sku"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Información Adicional" name="info">
                            <group>
                                <field name="notes" placeholder="Notas adicionales..."/>
                                <field name="webhook_received_at" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_tn_sale_order_search" model="ir.ui.view">
        <field name="name">tn.sale.order.search</field>
        <field name="model">tn.sale.order</field>
        <field name="arch" type="xml">
            <search string="Buscar Ventas TiendaNube">
                <field name="name"/>
                <field name="tn_order_id"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="tn_customer_id"/>
                <filter string="Abiertas" name="status_open" domain="[('status', '=', 'open')]"/>
                <filter string="Cerradas" name="status_closed" domain="[('status', '=', 'closed')]"/>
                <filter string="Canceladas" name="status_cancelled" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Hoy" name="today" domain="[('date_created', '>=', datetime.datetime.now().replace(hour=0, minute=0, second=0))]"/>
                <filter string="Esta Semana" name="this_week" domain="[('date_created', '>=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Estado de Pago" name="group_payment" context="{'group_by': 'payment_status'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date_created:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tn_sale_order" model="ir.actions.act_window">
        <field name="name">Ventas TiendaNube</field>
        <field name="res_model">tn.sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_status_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay ventas importadas desde TiendaNube aún.
            </p>
            <p>
                Las ventas se importan automáticamente cuando se crean en TiendaNube si tienes configurado un webhook.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_tn_sale_order"
              name="Ventas"
              parent="tiendanube_connector.menu_tn_publication_root"
              action="action_tn_sale_order"
              sequence="20"/>

</odoo>
